# cpt-mcp 配置模板
# 复制为 .env（该文件已被 .gitignore 忽略），或把同样的变量注入 MCP 客户端/宿主进程。
# cpt-mcp 本身不读取 .env；DSH 会在启动时加载 <DSH_HOME>/.env。

# ── FineReport 安装（本机相关，必须按机器配置）────────────────────────────
# 不要写死盘符；FR_HOME 指向 FineReport 安装根目录。
FR_HOME=<FineReport安装目录>

# 可选：官方 reportlets 目录；不设置时从 FR_HOME 推导。
#FR_REPORTLETS_DIR=<FR_HOME>/webapps/webroot/WEB-INF/reportlets

# 可选：单个官方样本 .cpt，供 probe-cpt-compat 使用。
#FR_SAMPLE=<FR_HOME>/webapps/webroot/WEB-INF/reportlets/GettingStarted.cpt

# ── 报表工作区与工具档位 ───────────────────────────────────────────────────
# 支持相对路径（按 MCP 进程当前工作目录解析）或绝对路径。
CPT_MCP_ALLOWED_ROOTS=./你的报表工作区

# generate / focused / report / full
CPT_MCP_TOOL_PROFILE=report

# local / real / both
CPT_MCP_SQL_TARGET=local

# ── 门禁输出（2026-11-12 P0-2）────────────────────────────────────────────
# 1 = validate_cpt / quality_gate_cpt / verify_cpt 默认回摘要（结论+前5条明细+计数，约 1.5~2KB）；
# 不设置或 0 = 默认完整明细（调用时仍可显式传 brief:true / brief:false 覆盖）。
#CPT_MCP_GATE_BRIEF=0

# 门禁结论缓存 TTL（毫秒，默认 600000 = 10 分钟；0 关闭）。
# 同文件同参数重复调用会复用上次结论（响应体带 cached:true / cachedAgeSeconds），
# 模板内容、引擎报告或本地 SQLite 库变化后自动重算。
#CPT_MCP_GATE_CACHE_TTL_MS=600000

# ── 本地预览（仅本机测试）─────────────────────────────────────────────────
# 不要填写生产平台口令。
#CPT_MCP_FR_PREVIEW_ADMIN_USER=admin
#CPT_MCP_FR_PREVIEW_ADMIN_PASSWORD=change-me

# ── 可选：只读数据库连接（不要提交真实凭据）──────────────────────────────
# 也可以使用 db-connections.json（已 gitignore）或 CPT_DB_CONN_FILE。
#CPT_DB_CONNECTIONS={"Doris":{"host":"example.internal","port":9030,"user":"readonly_user","password":"CHANGE_ME","database":"example_analytics"}}

# ── 可选：E2E 脚本样本（不设置时相关脚本自动跳过）────────────────────────
#CPT_E2E_SAMPLE=./tmp_test/example-zip-template.cpt
